<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="sharedpref" path="secure_prefs.xml"/>
    <exclude domain="sharedpref" path="secure_prefs_emergency.xml"/>
    <!-- Exclude entire database domain so bloom.db, WAL/SHM/journal, and timestamped bloom.db.bak_* recovery files are excluded -->
    <exclude domain="database" path="."/>
    <exclude domain="database" path="bloom.db"/>
    <exclude domain="database" path="bloom.db-wal"/>
    <exclude domain="database" path="bloom.db-shm"/>
    <exclude domain="database" path="bloom.db-journal"/>
</full-backup-content>
